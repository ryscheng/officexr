{
  "name": "officexr-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @officexr/web run dev",
    "build": "pnpm --filter @officexr/web run build",
    "db:migrate": "pnpm --filter @officexr/web run db:migrate",
    "preview": "pnpm --filter @officexr/web run preview",
    "build:web": "pnpm --filter @officexr/web run build",
    "test": "pnpm --filter @officexr/web --filter @officexr/sdk --filter @officexr/core-refactor --filter @officexr/realtime-server --filter @officexr/world --filter @officexr/studio --filter @officexr/studio-mcp run test",
    "test:sdk": "pnpm --filter @officexr/sdk run test",
    "test:core-refactor": "pnpm --filter @officexr/core-refactor run test",
    "test:realtime-server": "pnpm --filter @officexr/realtime-server run test",
    "test:world": "pnpm --filter @officexr/world run test",
    "test:studio": "pnpm --filter @officexr/studio run test",
    "typecheck": "pnpm --filter @officexr/web --filter @officexr/sdk --filter @officexr/core-refactor --filter @officexr/realtime-server --filter @officexr/world --filter @officexr/studio --filter @officexr/studio-mcp run typecheck",
    "bots:start": "pnpm --filter @officexr/world run bots:start",
    "dev:studio": "pnpm --filter @officexr/studio run dev",
    "asset-packs:install": "pnpm --filter @officexr/world run asset-packs:install",
    "state:backup": "pnpm --filter @officexr/world run state:backup",
    "state:reset": "pnpm --filter @officexr/world run state:reset",
    "gen:thumbnails": "pnpm --filter @officexr/world run gen:thumbnails",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "playwright test tests/playwright/map-editor.spec.ts tests/playwright/map-editor-hermetic.spec.ts tests/playwright/object-editor.spec.ts tests/playwright/routing.spec.ts tests/playwright/room-editor.spec.ts tests/playwright/debug-mode.spec.ts tests/playwright/character-on-surface.spec.ts tests/playwright/debug-world-constants-hermetic.spec.ts tests/playwright/render-page.spec.ts --project=chromium"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.1.2",
    "@playwright/test": "^1.60.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0"
  }
}
