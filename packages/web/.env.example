# Postgres connection string for the Supabase database. The web server reads offices
# from it directly (the browser makes no database calls), and `pnpm db:migrate`
# applies supabase/migrations to it. Run `pnpm db:migrate` before `start`, e.g. the
# container command: sh -c "pnpm db:migrate && pnpm --filter @officexr/web start"
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Google sign-in. Users sign in with Google; the server keeps their session in Postgres
# (the `session` table) and lets in only emails or domains in the `login_allowlist` table.
# `vite preview` / `start` refuses to boot unless all four are set.
# - Google Cloud console: create an OAuth client (Web application) and add the authorized
#   redirect URI ${PUBLIC_URL}/auth/google/callback, e.g. https://officexr.example.com/auth/google/callback.
# - Allow people with SQL (values lowercase; there is no admin UI):
#     insert into login_allowlist (kind, value) values ('domain', 'example.com');
#     insert into login_allowlist (kind, value) values ('email', 'someone@gmail.com');
# - When PUBLIC_URL is https the session cookie is Secure, so the TLS terminator in front of
#   the server must send `X-Forwarded-Proto: https`; otherwise the cookie is dropped and
#   login loops back to Google.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# Signs the session cookie; a long random string, e.g. `openssl rand -hex 32`.
# SESSION_SECRET=
# The external origin users reach the app at, no trailing slash.
# PUBLIC_URL=https://officexr.example.com

# Local dev only: `vite dev` (never preview) treats every request as this user, so it runs
# without the Google variables above.
OFFICEXR_DEV_USER_LOGIN=you@example.com
OFFICEXR_DEV_USER_NAME=You

# JaaS (Jitsi as a Service) Voice Chat — https://jaas.8x8.vc
# VITE_JAAS_APP_ID      — your App ID (format: vpaas-magic-cookie-…), shown on the dashboard
# VITE_JAAS_API_KEY_ID  — the Key ID shown next to the API key you created
# VITE_JAAS_PRIVATE_KEY — the RSA private key; paste the PEM block using \n for newlines, in quotes
VITE_JAAS_APP_ID=vpaas-magic-cookie-your-app-id
VITE_JAAS_API_KEY_ID=your-api-key-id
VITE_JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----"

# `vite dev` and `vite preview` serve the three VITE_JAAS_* values at /config.js,
# rendered from the process environment per request (dev also reads this .env).
# Run `pnpm --filter @officexr/web start` with them set (PORT, default 4173).

# Optional: load 3D assets (/models/..., baked layouts) from this base URL, e.g. a CDN,
# instead of the web server. No trailing slash. Served at /config.js like the keys above.
# OFFICEXR_ASSET_BASE_URL=https://assets.example.com
