# Origin of the OfficeXR backend (@officexr/server) when the SPA is hosted elsewhere, e.g. Cloudflare
# Pages. Build-time; leave unset for same-origin (`pnpm dev`). A split deployment also needs the
# backend's frontend-origin allowlist to include the SPA and OFFICEXR_ASSET_BASE_URL set on the backend.
# VITE_API_ORIGIN=https://api.example.com

# Voice needs no browser-side secrets: the SPA reads only the public JaaS app id from /config.js and
# fetches each user's JaaS token from the backend (GET /api/offices/:id/voice-token). The JaaS keys
# (VITE_JAAS_APP_ID, OFFICEXR_JAAS_API_KEY_ID, OFFICEXR_JAAS_PRIVATE_KEY) are backend env; for
# `pnpm dev` put them in this directory's .env, see packages/server/.env.example.
