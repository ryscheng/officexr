# Origin of the OfficeXR backend (@officexr/server) when the SPA is hosted elsewhere, e.g. Cloudflare
# Pages. Build-time; leave unset for same-origin (`pnpm dev`). A split deployment also needs the
# backend's frontend-origin allowlist to include the SPA and OFFICEXR_ASSET_BASE_URL set on the backend.
# VITE_API_ORIGIN=https://api.example.com
