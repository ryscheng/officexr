    "db:migrate": "supabase db push --yes --workdir ../.. --db-url \"$SUPABASE_DB_URL\""
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/tiny5": "^5.3.0",
    "@jitsi/react-sdk": "^1.4.4",
    "@officexr/core-refactor": "workspace:*",
    "@officexr/sdk": "workspace:*",
    "@officexr/server": "workspace:*",
    "@officexr/world": "workspace:*",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.7",
    "lucide-react": "^0.475.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.7.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9",
    "jsdom": "^25.0.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.2",
    "vitest": "^4.1.3"
