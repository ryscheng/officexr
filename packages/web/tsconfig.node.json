{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "composite": true,
    "rootDir": "..",
    "outDir": "node_modules/.tmp/tsconfig-node"
  },
  "include": ["vite.config.ts", "../core/src/lib/runtime-config-keys.ts"]
}
