# The web backend: `pnpm --filter @officexr/server start` reads these from the process
# environment; `pnpm dev` reads them from packages/web/.env (copy this file there).

# Public port: /api, /auth, /config.js, /models, the realtime /ws, /health and
# /rooms/:id/sessions. No SPA is served here; GET / is a 404. Default 4173.
# PORT=4173
# Internal port serving only PUT /admin/world-constants; keep it off the public network.
# Default 8787, which clashes with a local realtime CLI or `pnpm bots:start`: set it to
# run both. `pnpm dev` has no admin port.
# ADMIN_PORT=8787
# Bearer token for PUT /admin/world-constants; unset disables the route.
# OFFICEXR_REALTIME_ADMIN_TOKEN=
# Where realtime loads its world constants at boot. Default: this server's
# http://127.0.0.1:${PORT}/api/world-settings.
# OFFICEXR_WORLD_CONSTANTS_URL=

# Postgres connection string for the Supabase database. The web server reads offices
# from it directly (the browser makes no database calls), and `pnpm db:migrate`
# applies supabase/migrations to it. Run `pnpm db:migrate` before `start`, e.g. the
# container command: sh -c "pnpm db:migrate && pnpm --filter @officexr/server start"
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Google sign-in. Users sign in with Google; the server keeps their session in Postgres
# (the `session` table) and lets in only emails or domains in the `login_allowlist` table.
# `pnpm --filter @officexr/server start` refuses to boot unless all four are set.
# - Google Cloud console: create an OAuth client (Web application) and add the authorized
#   redirect URI ${PUBLIC_URL}/auth/google/callback, e.g. https://officexr.example.com/auth/google/callback.
# - Allow people with SQL (values lowercase; there is no admin UI):
#     insert into login_allowlist (kind, value) values ('domain', 'example.com');
#     insert into login_allowlist (kind, value) values ('email', 'someone@gmail.com');
# - When PUBLIC_URL is https the session cookie is Secure, so the TLS terminator in front of
#   the server must send `X-Forwarded-Proto: https`; otherwise the cookie is dropped and
#   login loops back to Google.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# Signs the session cookie; a long random string, e.g. `openssl rand -hex 32`.
# SESSION_SECRET=
# The external origin users reach the app at, no trailing slash.
# PUBLIC_URL=https://officexr.example.com
# Frontends on other origins that may call this backend with credentials and be returned to after
# sign-in: comma-separated exact origins (scheme://host[:port], no path), or https wildcards whose `*`
# is one leftmost DNS label (https://*.officexr.pages.dev, for Cloudflare Pages previews). The first
# must be exact: it is the default landing page and where login errors go. A sign-in returning to one
# outside COOKIE_DOMAIN gets a 10-minute token in the URL fragment instead of a usable cookie. Each must be same-site with PUBLIC_URL (same registrable
# domain; the cookie is SameSite=Lax). Unset: same-origin only.
# FRONTEND_ORIGINS=https://officexr.example.com,https://studio.example.com,https://*.officexr.pages.dev
# Share the session cookie across subdomains: a domain PUBLIC_URL's host is on or under, e.g.
# example.com. Turning it on signs everyone out once; the server then expires the old host-only cookie
# on the next sign-in or sign-out.
# COOKIE_DOMAIN=example.com

# Local dev only: `pnpm dev` (never `start`) treats every request as this user, so it runs
# without the Google variables above.
OFFICEXR_DEV_USER_LOGIN=you@example.com
OFFICEXR_DEV_USER_NAME=You

# Realtime join tokens. When set, `/api/realtime-token` mints short-lived tokens for the
# signed-in user and the in-process realtime server requires them (a long random string,
# e.g. `openssl rand -hex 32`). Unset, the endpoint is 404 and clients join without a token.
# OFFICEXR_REALTIME_TOKEN_SECRET=
# Also accepted as `Authorization: Bearer <token>` on the API; the realtime server uses it to read offices.

# JaaS (Jitsi as a Service) Voice Chat — https://jaas.8x8.vc
# The server signs each user's JaaS JWT at GET /api/offices/:id/voice-token (signed-in users only,
# 1-hour tokens). Voice is on when all three are set; otherwise the endpoint is 404 and voice is off.
# VITE_JAAS_APP_ID          — your App ID (format: vpaas-magic-cookie-…), shown on the dashboard.
#                             Public: served to browsers at /config.js and used by the server to sign.
# OFFICEXR_JAAS_API_KEY_ID  — server-only: the Key ID shown next to the API key you created.
# OFFICEXR_JAAS_PRIVATE_KEY — server-only, never served to browsers: the RSA private key, either the PEM
#                             block in quotes with \n for newlines, or the base64 of the PEM file.
#                             If it is set but not a valid key, the server logs an error and voice is off.
# The old VITE_JAAS_API_KEY_ID / VITE_JAAS_PRIVATE_KEY names are still read as a deprecated fallback
# (with a warning) for one release, but are no longer served at /config.js. Move to the names above.
VITE_JAAS_APP_ID=vpaas-magic-cookie-your-app-id
OFFICEXR_JAAS_API_KEY_ID=your-api-key-id
OFFICEXR_JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----"

# /config.js is rendered from the process environment per request (`pnpm dev` also reads
# packages/web/.env) and serves only VITE_JAAS_APP_ID and OFFICEXR_ASSET_BASE_URL.

# Optional: load 3D assets (/models/..., baked layouts) from this base URL, e.g. a CDN,
# instead of the web server. No trailing slash. Served at /config.js like the app id above.
# OFFICEXR_ASSET_BASE_URL=https://assets.example.com
